# --- Zorunlu ---
DISCORD_TOKEN=
# Özet / rapor kanalı (yetkililer)
REPORT_CHANNEL_ID=
# Sunucu ID'si: slash komutları anında görünsün diye (boşsa global sync, ~1 saat sürebilir)
GUILD_ID=

# Mesajları Türkçeye çevir (ücretsiz Google Translate web uç noktası, anahtar gerekmez)
TRANSLATE_ENABLED=true

# --- Öneri kanalı ---
SUGGESTION_CHANNEL_ID=
DAILY_SUMMARY_TIME=21:00
TIMEZONE=Europe/Istanbul

# --- Ticket ---
# Ticket kanallarının bulunduğu kategori ID'leri (virgülle) ve/veya kanal adı öneki
TICKET_CATEGORY_IDS=
TICKET_CHANNEL_PREFIX=ticket-
# Yeni ticket açıldıktan kaç saniye sonra otomatik özet atılsın (0 = kapalı)
TICKET_AUTO_SUMMARY_DELAY=300

# --- Moderasyon ---
MODERATION_ENABLED=true
# Log kanalı (boşsa REPORT_CHANNEL_ID)
MOD_LOG_CHANNEL_ID=
# Taranmayacak kanallar ve muaf roller (virgülle)
MOD_IGNORED_CHANNEL_IDS=
MOD_EXEMPT_ROLE_IDS=

# Yasaklı kelimeler banned_words.txt dosyasında
BLOCK_INVITES=true
# true ise sadece ALLOWED_LINK_DOMAINS'teki sitelere link verilebilir
BLOCK_LINKS=false
ALLOWED_LINK_DOMAINS=youtube.com,youtu.be,tenor.com,imgur.com
# Bir mesajda en fazla kaç kişi etiketlenebilir
MAX_MENTIONS=5
# SPAM_SECONDS saniyede SPAM_MESSAGES'tan fazla mesaj = spam
SPAM_MESSAGES=6
SPAM_SECONDS=5
# Aynı mesaj üst üste kaç kez gönderilebilir
DUPLICATE_LIMIT=3
# Bu uzunluktan uzun ve %80+ büyük harfli mesajlar uyarılır
CAPS_MIN_LENGTH=15

# Kaç uyarıdan sonra timeout, kaç dakika, uyarılar kaç gün geçerli
WARN_TIMEOUT_THRESHOLD=3
TIMEOUT_MINUTES=30
WARN_EXPIRE_DAYS=30
