# ============ Zorunlu ============
DISCORD_TOKEN=
# Sunucu ID'si: slash komutları anında görünsün diye (boşsa Discord'un senkronu ~1 saat sürebilir)
GUILD_ID=

# Paneli kullanabilecek ek roller (virgülle). "Mesajları Yönet" yetkisi olanlar zaten kullanabilir.
STAFF_ROLE_IDS=

# ============ /summary — öneri paneli ============
# /summary yazıp kanal seçmezsen kullanılacak öneri kanalı
SUGGESTION_CHANNEL_ID=
# Kanalda geriye doğru en fazla kaç mesaj taransın
SUGGESTION_SCAN_LIMIT=3000
# Önerileri Türkçeye çevir (ücretsiz Google Translate web adresi, anahtar gerekmez)
TRANSLATE_ENABLED=true

# Oy sayılan tepkiler (virgülle)
UP_VOTE_EMOJIS=👍,⬆️,🔼,✅
DOWN_VOTE_EMOJIS=👎,⬇️,🔽,❌
# Karar verilen öneriye botun ekleyeceği işaret
ACCEPT_EMOJI=✅
REJECT_EMOJI=❌

# Öneri kanalına gidecek cevabın metinleri (kanal uluslararası olduğu için İngilizce)
ACCEPT_TITLE=✅ Suggestion accepted
REJECT_TITLE=❌ Suggestion rejected
REASON_LABEL=Reason
REVIEWED_BY_LABEL=Reviewed by

# ============ Etiket uyarısı ============
# Botun etiketlere cevap vereceği kanallar: kanal adı veya ID, virgülle
MENTION_GUARD_CHANNELS=general-english,general-br
# Etiketlenince uyarı verilecek kişi/rol adları veya ID'leri, virgülle
# (hem gerçek etiketi hem düz yazılmış "@sawog" metnini yakalar)
MENTION_GUARD_TARGETS=sawog,admin
MENTION_GUARD_MESSAGE=Please open a ticket if you need something.
# Aynı kişiye en az kaç saniyede bir cevap verilsin (0 = her seferinde)
MENTION_GUARD_COOLDOWN=0
